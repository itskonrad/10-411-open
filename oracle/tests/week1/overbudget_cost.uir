# expect: budget
# Few nodes, huge static cost: each level calls the level below twice, so cost(level k) is about 3 * 2^k.
%x = param [] slot=0 dtype=i32 addrspace=ALU
%y = param [] slot=1 dtype=i32 addrspace=ALU
%f0 = add %x %y
%a1 = call %f0 %x %y
%b1 = call %f0 %y %x
%f1 = add %a1 %b1
%a2 = call %f1 %x %y
%b2 = call %f1 %y %x
%f2 = add %a2 %b2
%a3 = call %f2 %x %y
%b3 = call %f2 %y %x
%f3 = add %a3 %b3
%a4 = call %f3 %x %y
%b4 = call %f3 %y %x
%f4 = add %a4 %b4
%a5 = call %f4 %x %y
%b5 = call %f4 %y %x
%f5 = add %a5 %b5
%a6 = call %f5 %x %y
%b6 = call %f5 %y %x
%f6 = add %a6 %b6
%a7 = call %f6 %x %y
%b7 = call %f6 %y %x
%f7 = add %a7 %b7
%a8 = call %f7 %x %y
%b8 = call %f7 %y %x
%f8 = add %a8 %b8
%a9 = call %f8 %x %y
%b9 = call %f8 %y %x
%f9 = add %a9 %b9
%a10 = call %f9 %x %y
%b10 = call %f9 %y %x
%f10 = add %a10 %b10
%a11 = call %f10 %x %y
%b11 = call %f10 %y %x
%f11 = add %a11 %b11
%a12 = call %f11 %x %y
%b12 = call %f11 %y %x
%f12 = add %a12 %b12
%a13 = call %f12 %x %y
%b13 = call %f12 %y %x
%f13 = add %a13 %b13
%a14 = call %f13 %x %y
%b14 = call %f13 %y %x
%f14 = add %a14 %b14
%a15 = call %f14 %x %y
%b15 = call %f14 %y %x
%f15 = add %a15 %b15
%a16 = call %f15 %x %y
%b16 = call %f15 %y %x
%f16 = add %a16 %b16
%a17 = call %f16 %x %y
%b17 = call %f16 %y %x
%f17 = add %a17 %b17
%a18 = call %f17 %x %y
%b18 = call %f17 %y %x
%f18 = add %a18 %b18
%a19 = call %f18 %x %y
%b19 = call %f18 %y %x
%f19 = add %a19 %b19
%r = call %f19 1 2
%test = assert %r 0
