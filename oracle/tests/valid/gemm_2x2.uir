# C = A @ B for 2x2 f32 matrices, row-major, in week-3 loop form (no REDUCE).
# A = [[1 2] [3 4]], B = [[5 6] [7 8]]
# C = [[1*5+2*7 1*6+2*8] [3*5+4*7 3*6+4*8]] = [[19 22] [43 50]]
%A    = buffer 4 slot=0 dtype=f32
%B    = buffer 4 slot=1 dtype=f32
%C    = buffer 4 slot=2 dtype=f32
%Ar   = after %A (store %A [1 2 3 4])
%Br   = after %B (store %B [5 6 7 8])
%i    = range 2 slot=0
%j    = range 2 slot=1
%k    = range 2 slot=2
%ci   = add (mul %i 2) %j
# the accumulator init uses only i and j, so it runs once per (i, j), before the k loop reads it
%init = store (index %C %ci) 0.0
%Ck   = after %C %init %k
%a    = load (index %Ar (add (mul %i 2) %k))
%b    = load (index %Br (add (mul %k 2) %j))
%acc  = store (index %Ck %ci) (add (load (index %Ck %ci)) (mul %a %b))
%done = end (end (end %acc %k) %j) %i
%test = assert (after %C %done) [19 22 43 50]
