# STAGE keeps x*x in a temp buffer, because two loops need it: the sum, and the output.
# x = [1 2 3]: sq = [1 4 9], total 14, sq + 14 = [15 18 23].
%x     = buffer 3 slot=0 dtype=i32
%sx    = store %x [1 2 3]
%xv    = load (after %x %sx)
%sq    = stage (mul %xv %xv)
%total = reduce %sq op=add pop=1
%test  = assert (add %sq (expand %total 3)) [15 18 23]
